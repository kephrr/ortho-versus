{
  "name": "alphabet-contest-monorepo",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev:back": "pnpm --filter @app/backend dev",
    "dev:front": "pnpm --filter @app/frontend dev",
    "dev": "pnpm --parallel run dev",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "curate": "pnpm --filter @app/audio-curator curate"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
